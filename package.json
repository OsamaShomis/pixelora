    "@vitejs/plugin-react": "^5.0.4",
    "arabic-persian-reshaper": "^1.0.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "html-to-pdfmake": "^2.5.34",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfmake-rtl": "^2.1.2",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
